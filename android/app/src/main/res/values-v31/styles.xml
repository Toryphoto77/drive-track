<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v1.0.0：只对 API 31+（Android 12+ SplashScreen API）生效。
         LaunchTheme 用黑色父主题，系统启动画面背景定死黑色，
         v1.0.4：系统启动动画图标改为默认红赛车 @mipmap/ic_launcher_red
         （此前为旧转速表图标，是启动后仍见旧图的
         第二处根因；系统限制：原生启动阶段拿不到用户选择的蓝仪表，
         系统启动图标固定为默认红，Flutter 启动页内再跟随用户选择）；
         NormalTheme 不在此重定义，沿用 values/ 里已改黑的那份。
         注意：Android 12+ 的系统启动画面时长/图标裁剪由各厂商
         ROM 控制，仍需真机看实际表现（见回执已知限制）。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_red</item>
    </style>
</resources>
